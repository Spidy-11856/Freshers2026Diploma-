# PostgreSQL — use Neon, Supabase, or any managed Postgres
DATABASE_URL="postgresql://user:password@host:5432/freshers2026?sslmode=require"

# Razorpay — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Auth — generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-very-long-random-string-32chars-min"

# Optional: Cloudflare R2 for image uploads
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="freshers2026-media"
# R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"

# Next.js
NEXT_PUBLIC_APP_URL="https://freshers.umu.ac.in"
